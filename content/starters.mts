/**
 * Starters practice pack — ORIGINAL content written for SHINING English.
 * Words follow the Cambridge Pre A1 Starters vocabulary and grammar lists
 * (topics, not copied exercises). Nothing here is taken from "Get Ready for
 * Starters", Authentic Exam Papers or Global Success books.
 *
 * Pictures are Microsoft Fluent Emoji (MIT), written here as the emoji
 * itself; scripts/build-content.mts turns them into image codes, checks each
 * image exists, copies it to public/emoji/ and writes the SQL migration.
 *
 * Teachers can edit everything in the app afterwards — this file only seeds
 * the first version.
 */

export type Word = [word: string, meaningVi: string, emoji: string, pos?: string];
/** [picture, sentence, is it true?] */
export type TrueFalse = [emoji: string, sentence: string, answer: boolean];
/** [picture, sentence with ___, answer, wrong option, wrong option] */
export type FillBlank = [emoji: string, sentence: string, answer: string, wrong1: string, wrong2: string];
/** [picture, sentence] — the words are shuffled for the child to reorder */
export type Rearrange = [emoji: string, sentence: string];

export type Topic = {
  code: string;
  en: string;
  vi: string;
  emoji: string;
  words: Word[];
  trueFalse: TrueFalse[];
  fillBlank: FillBlank[];
  rearrange: Rearrange[];
};

