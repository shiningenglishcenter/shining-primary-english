/**
 * Teacher feedback C1 (2026-11-20, ARCHITECTURE D45): pictures that did not
 * show the meaning well enough. The new pictures are composed at build time
 * by scripts/make-pictures.mjs (codes f0001…). Migration 0028 (generated by
 * scripts/build-content.mts) applies these to seeded words and sentence
 * items only where nobody changed them.
 *
 * "This is …" / "That is …" sentences get a pointing hand in the player
 * itself (PointPic), so they need no data change.
 */

export const GARDEN = "f0001";
export const MONKEY_IN_TREE = "f0002";
export const GRANDFATHER = "f0003";
export const GRANDMOTHER = "f0004";
export const FROG_JUMPING = "f0005";

/** Words: [level, word, old emoji code, new code]. */
export const WORD_FIXES: [level: string, word: string, from: string, to: string][] = [
  ["STARTERS", "garden", "1f3e1", GARDEN],
  ["STARTERS", "grandfather", "1f474", GRANDFATHER],
  ["STARTERS", "grandmother", "1f475", GRANDMOTHER],
  ["GS1", "grandma", "1f475", GRANDMOTHER],
];

/** Sentence items: the new picture for an item, or null to keep it. */
export function fixItemPicture(sentence: string, emoji: string | null | undefined): string | null {
  const s = sentence.toLowerCase();
  // "The ___ is in the tree." / "The monkey is in the ___." (answer: tree)
  if (emoji === "1f412" && (/\btree\b/.test(s) || /in the ___/.test(s))) return MONKEY_IN_TREE;
  if (emoji === "1f438" && /\bjump/.test(s)) return FROG_JUMPING;
  if (emoji === "1f337" && /\bgarden\b/.test(s)) return GARDEN;
  if (emoji === "1f474") return GRANDFATHER;
  if (emoji === "1f475") return GRANDMOTHER;
  return null;
}
