/**
 * Round 3 (ARCHITECTURE D53): British IPA for the words of the seeded packs,
 * taken from Britfone (MIT, https://github.com/JoseLlarena/Britfone) and
 * written to content/ipa.mts. Run once when words are added:
 *
 *   node scripts/make-ipa.mts <path to britfone.main.3.0.1.csv>
 *
 * Britfone marks stress before the vowel and uses narrow symbols; for
 * children's cards we write dictionary style: stress before the syllable,
 * none on one-syllable words, "r" and "e" instead of "ɹ" and "ɛ".
 */
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import * as starters from "../content/starters.mts";
import * as gs1 from "../content/gs1.mts";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const source = process.argv[2];
if (!source) throw new Error("usage: node scripts/make-ipa.mts <britfone.main.csv>");

const dict = new Map<string, string[]>();
for (const line of readFileSync(source, "utf8").split("\n")) {
  const m = line.match(/^([^,]+), (.+)$/);
  if (!m) continue;
  const word = m[1]!.replace(/\(\d+\)$/, "").toLowerCase();
  if (!dict.has(word)) dict.set(word, m[2]!.trim().split(/\s+/));
}

const VOWEL = /^(aɪ|aʊ|eɪ|əʊ|ɔɪ|ɪə|eə|ɛə|ʊə|iː|uː|ɑː|ɔː|ɜː|æ|ɒ|ə|ɪ|ʊ|ʌ|ɛ|e|i|u|ɐ)$/;
// (ɐ is Britfone's STRUT vowel; written ʌ below.)
const ONSET2 = new Set(["pr", "pl", "br", "bl", "tr", "dr", "kr", "kl", "gr", "gl", "fr", "fl", "θr", "ʃr", "sp", "st", "sk", "sm", "sn", "sl", "sw", "tw", "kw", "dw", "pj", "bj", "kj", "mj", "nj", "fj", "vj", "hj"]);
const ONSET3 = new Set(["spr", "str", "skr", "spl", "skw"]);

function dictionaryStyle(phones: string[]): string {
  const p = phones.map((x) =>
    x.replace(/ɹ/g, "r").replace(/ɛə/g, "eə").replace(/ɛ/g, "e").replace(/ɐ/g, "ʌ"),
  );
  const plain = (x: string) => x.replace(/[ˈˌ]/g, "");
  const vowels = p.filter((x) => VOWEL.test(plain(x))).length;
  const out: string[] = [];
  for (let i = 0; i < p.length; i++) {
    const mark = p[i]!.match(/^[ˈˌ]/)?.[0];
    const ph = plain(p[i]!);
    if (mark && vowels > 1) {
      // Move the mark before the consonants that start this syllable.
      let k = out.length;
      const before = (n: number) => out.slice(k - n, k).join("");
      const isC = (x: string | undefined) => x !== undefined && !VOWEL.test(x);
      if (isC(out[k - 1])) {
        if (isC(out[k - 2]) && isC(out[k - 3]) && ONSET3.has(before(3))) k -= 3;
        else if (isC(out[k - 2]) && ONSET2.has(before(2))) k -= 2;
        else k -= 1;
      }
      out.splice(k, 0, mark);
    }
    out.push(ph);
  }
  return out.join("");
}

/** Words Britfone lacks, written by hand (dictionary style). */
const MANUAL: Record<string, string> = { crayon: "ˈkreɪɒn", mango: "ˈmæŋgəʊ" };

function ipaOf(word: string): string | null {
  if (MANUAL[word.toLowerCase()]) return MANUAL[word.toLowerCase()]!;
  const parts = word.toLowerCase().split(/\s+/);
  const each = parts.map((w) => dict.get(w));
  if (each.some((x) => !x)) return null;
  return each.map((x) => dictionaryStyle(x!)).join(" ");
}

const words = [...new Set([...starters.TOPICS, ...gs1.TOPICS].flatMap((t) => t.words.map((w) => w[0])))].sort();
const found: [string, string][] = [];
const missing: string[] = [];
for (const w of words) {
  const ipa = ipaOf(w);
  if (ipa) found.push([w, ipa]);
  else missing.push(w);
}
const file = `/**
 * British IPA for the seeded words (ARCHITECTURE D53), generated by
 * scripts/make-ipa.mts from Britfone 3.0.1 (MIT, © 2017 Jose Llarena,
 * https://github.com/JoseLlarena/Britfone). Teachers can edit each word's IPA
 * in the app. Not found in Britfone: ${missing.join(", ") || "none"}.
 */
export const IPA: Record<string, string> = {
${found.map(([w, i]) => `  ${JSON.stringify(w)}: ${JSON.stringify(i)},`).join("\n")}
};
`;
writeFileSync(join(root, "content", "ipa.mts"), file);
console.warn(`make-ipa: ${found.length} words, missing: ${missing.join(", ") || "none"}`);
